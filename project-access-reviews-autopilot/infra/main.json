      "name": "[format('{0}/{1}/{2}/{3}', variables('sbName'), 'review-work', 'slack-notify', 'notify-filter')]",
      "properties": {
        "filterType": "SqlFilter",
        "sqlFilter": {
          "sqlExpression": "sys.Label <> 'ApplyDecision'"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces/topics/subscriptions', variables('sbName'), 'review-work', 'slack-notify')]"
      ]
    },
    {
      "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
      "apiVersion": "2026-01-01",
      "name": "[format('{0}/{1}/{2}', variables('sbName'), 'review-work', 'apply-decision')]",
      "properties": {
