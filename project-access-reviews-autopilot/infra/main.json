      "apiVersion": "2026-01-01",
      "name": "[format('{0}/{1}/{2}/{3}', variables('sbName'), 'review-work', 'apply-decision', 'apply-filter')]",
      "properties": {
        "filterType": "SqlFilter",
        "sqlFilter": {
          "sqlExpression": "sys.Label = 'ApplyDecision'"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces/topics/subscriptions', variables('sbName'), 'review-work', 'apply-decision')]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ServiceBus/namespaces', variables('sbName'))]",
